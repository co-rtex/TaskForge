# Copy to .env and adjust. .env is git-ignored and must never contain a real secret.
# Values below are local development placeholders only.

# --- Database ---
TASKFORGE_DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5442/taskforge?sslmode=disable

# --- API service ---
TASKFORGE_API_ADDR=127.0.0.1:8080
# Maximum accepted request body, in bytes.
TASKFORGE_MAX_REQUEST_BYTES=262144
# Bounds every handler and the database work it performs. This deadline can
# elapse while acquiring a lock, while executing a statement, or during COMMIT.
# A worker-control request that exhausts it returns HTTP 503
# `service_unavailable`.
#
# A deadline reached during COMMIT leaves the immediate outcome unknown, so the
# response does not promise that nothing committed. The caller should retry the
# identical request using that operation's own identity or fence — the same
# session identity for registration and heartbeat, the same session and claim
# request id for a claim, the same attempt fence for start and succeed, and for
# renewal the same fence PLUS the same renewal request id and expected
# generation. Each is idempotent under those identifiers, so a replay returns the
# already-committed result instead of producing a second one.
TASKFORGE_API_REQUEST_TIMEOUT=25s
# Server-owned lease window, issued at claim and reissued by every renewal. A
# worker never supplies its own expiry.
#
# Work is NOT limited to one lease. A running attempt renews on
# TASKFORGE_LEASE_RENEW_INTERVAL below, so cooperative work may safely run across
# many lease windows for as long as renewal keeps succeeding. What still bounds
# one execution is the job's own timeout_seconds, which renewal never extends.
#
# How that budget is enforced: the worker runs the handler with a
# deadline-bearing context and cancels that context when the budget elapses, or
# when it can no longer prove it still holds the lease. A cooperative handler
# observes the cancellation and returns. Go cannot forcibly terminate arbitrary
# handler code, so an uncooperative handler may keep running until it returns on
# its own or the process exits. What is guaranteed is the control-plane side:
# once lease authority is gone, the worker cannot successfully report completion,
# because PostgreSQL rejects the fenced transition — and the reconciler will
# abandon that attempt and hand the job to another worker.
TASKFORGE_LEASE_DURATION=30s

# --- Liveness and lease renewal ---
# How often a worker proves its process session is alive. The control plane
# stamps PostgreSQL receipt time; a worker-supplied clock is never authoritative.
TASKFORGE_HEARTBEAT_INTERVAL=5s
# How long a current session may go unheard-from before the reconciler marks it
# UNHEALTHY. Must be at least 3x TASKFORGE_HEARTBEAT_INTERVAL, so one lost
# request cannot make a healthy worker look dead. Validated at startup.
TASKFORGE_SESSION_STALE_AFTER=15s
# How often a running attempt renews its lease. Must be at most one third of
# TASKFORGE_LEASE_DURATION, so renewal can fail twice and still succeed before
# the lease PostgreSQL owns expires. Validated at startup.
#
# Renewal is idempotent under a client-generated renewal request id plus the
# expected generation. Retrying an ambiguous renewal MUST reuse both; generating
# a fresh id would extend the lease a second time.
TASKFORGE_LEASE_RENEW_INTERVAL=10s

# --- Reconciler ---
# Repairs durable state no live process will repair: stale sessions, and expired
# leases whose attempts must be abandoned so capacity is released and recoverable
# work is requeued. Safe to run with several replicas.
TASKFORGE_RECONCILER_ADDR=127.0.0.1:8083
TASKFORGE_RECONCILER_POLL_INTERVAL=2s
# Maximum candidates examined per scan, per pass. Bounds one transaction batch,
# not total throughput: the next tick picks up whatever did not fit.
TASKFORGE_RECONCILER_BATCH_SIZE=50

# --- Broker (SQS-compatible) ---
TASKFORGE_BROKER_ENDPOINT=http://127.0.0.1:9324
TASKFORGE_BROKER_QUEUE_NAME=taskforge-work-available
TASKFORGE_BROKER_REGION=us-east-1
# ElasticMQ ignores credentials but the AWS SDK requires them to be present.
# These are not secrets and must be replaced by real IAM credentials in AWS.
TASKFORGE_BROKER_ACCESS_KEY_ID=local
TASKFORGE_BROKER_SECRET_ACCESS_KEY=local

# --- Outbox publisher ---
TASKFORGE_OUTBOX_ADDR=127.0.0.1:8081
TASKFORGE_OUTBOX_BATCH_SIZE=50
TASKFORGE_OUTBOX_POLL_INTERVAL=1s
# How long a claimed-but-unpublished event stays invisible to other publishers.
TASKFORGE_OUTBOX_CLAIM_TIMEOUT=30s
TASKFORGE_OUTBOX_BACKOFF_BASE=1s
TASKFORGE_OUTBOX_BACKOFF_MAX=5m
TASKFORGE_OUTBOX_BACKOFF_MULTIPLIER=2.0
TASKFORGE_OUTBOX_BACKOFF_JITTER=0.2

# --- Development authentication scope ---
# TEMPORARY. Milestone M3 has no API-key authentication; every request is
# attributed to this single scope. Database-backed API keys are milestone M5.
# The service must stay bound to loopback until then.
TASKFORGE_DEV_SCOPE=local-dev

# --- Worker process ---
TASKFORGE_WORKER_API_URL=http://127.0.0.1:8080
TASKFORGE_WORKER_ADDR=127.0.0.1:8082
# Stable logical worker name. `local-worker` is a single-process development
# default. Concurrently running workers MUST each be given a stable, distinct
# name: one logical worker allows only one current process session, so a second
# worker booting under the same name fences the first, and the fenced process
# exits. Keep the name stable across restarts of the same logical worker.
TASKFORGE_WORKER_NAME=local-worker
# Optional override; defaults to the operating-system hostname.
TASKFORGE_WORKER_HOSTNAME=
TASKFORGE_WORKER_GROUP=default
TASKFORGE_WORKER_QUEUE=default
TASKFORGE_WORKER_CONCURRENCY=4
# Comma-separated set declared by this process boot.
TASKFORGE_WORKER_CAPABILITIES=cpu
# Broker long-poll wait. Must be between 1s and 20s: the SQS ReceiveMessage
# request carries whole seconds, so a sub-second value truncates to 0, disables
# long polling, and busy-loops every idle slot.
TASKFORGE_WORKER_POLL_WAIT=10s
TASKFORGE_WORKER_REQUEST_TIMEOUT=10s
TASKFORGE_WORKER_SHUTDOWN_TIMEOUT=15s

# --- Logging ---
TASKFORGE_LOG_LEVEL=info

# --- Integration tests (make test-integration) ---
TASKFORGE_TEST_DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5442/taskforge?sslmode=disable
