# Copy to .env and adjust. .env is git-ignored and must never contain a real secret.
# Values below are local development placeholders only.

# --- Database ---
TASKFORGE_DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5442/taskforge?sslmode=disable

# --- API service ---
TASKFORGE_API_ADDR=127.0.0.1:8080
# Maximum accepted request body, in bytes.
TASKFORGE_MAX_REQUEST_BYTES=262144

# --- Broker (SQS-compatible) ---
TASKFORGE_BROKER_ENDPOINT=http://127.0.0.1:9324
TASKFORGE_BROKER_QUEUE_NAME=taskforge-work-available
TASKFORGE_BROKER_REGION=us-east-1
# ElasticMQ ignores credentials but the AWS SDK requires them to be present.
# These are not secrets and must be replaced by real IAM credentials in AWS.
TASKFORGE_BROKER_ACCESS_KEY_ID=local
TASKFORGE_BROKER_SECRET_ACCESS_KEY=local

# --- Outbox publisher ---
TASKFORGE_OUTBOX_ADDR=127.0.0.1:8081
TASKFORGE_OUTBOX_BATCH_SIZE=50
TASKFORGE_OUTBOX_POLL_INTERVAL=1s
# How long a claimed-but-unpublished event stays invisible to other publishers.
TASKFORGE_OUTBOX_CLAIM_TIMEOUT=30s
TASKFORGE_OUTBOX_BACKOFF_BASE=1s
TASKFORGE_OUTBOX_BACKOFF_MAX=5m
TASKFORGE_OUTBOX_BACKOFF_MULTIPLIER=2.0
TASKFORGE_OUTBOX_BACKOFF_JITTER=0.2

# --- Development authentication scope ---
# TEMPORARY. Milestone M1 has no API-key authentication; every request is
# attributed to this single scope. Database-backed API keys are milestone M5.
# The service must stay bound to loopback until then.
TASKFORGE_DEV_SCOPE=local-dev

# --- Logging ---
TASKFORGE_LOG_LEVEL=info

# --- Integration tests (make test-integration) ---
TASKFORGE_TEST_DATABASE_URL=postgres://taskforge:taskforge@127.0.0.1:5442/taskforge?sslmode=disable
