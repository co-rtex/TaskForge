# Binaries
/bin/
/dist/
*.exe
*.test
*.out

# Local environment — never commit real secrets
.env
.env.*
!.env.example

# Docker volumes / local data
/.data/
/pgdata/

# Reviewer patch artifacts (generated, never project source)
/*.patch
/*.diff

# Tooling caches
/.cache/
/coverage.out
/coverage.html

# Node / Python (later milestones)
node_modules/
__pycache__/
*.egg-info/
.venv/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python SDK build output (sdk/python). __pycache__/, *.egg-info/ and .venv/
# are already ignored above.
/sdk/python/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Dashboard build output (`make dash-build`). Only .gitkeep is tracked, which is
# what lets go:embed -- and so every binary -- compile on a clean clone before
# the frontend has ever been built. See internal/dashboard.
/internal/dashboard/dist/*
!/internal/dashboard/dist/.gitkeep
